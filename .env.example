# Server-side email delivery for the portfolio contact form.
# Never commit your real API key. Put real values in .env.local and in Vercel Environment Variables.

RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=kototsiaro@gmail.com

# Testing: Resend's onboarding sender can be used while sending only to the email address tied to your Resend account.
# Production: replace this with an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Tsiaro Portfolio <onboarding@resend.dev>"
